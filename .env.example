# Runtime database URL (a pooled connection is recommended on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct connection used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Vercel Blob read/write token for image uploads
BLOB_READ_WRITE_TOKEN=""

# Public canonical URL, without a trailing slash
NEXT_PUBLIC_APP_URL="http://localhost:3000"
